# LLM 服务（OpenAI 兼容格式）
LLM_API_KEY=your_llm_api_key
LLM_API_BASE=http://muses-openapi-prod.weizhipin.com/v1
LLM_MODEL=ark/deepseek-v4-1-flash
# 任务正文推理档位：none 首字/总耗时最低；质量回归时可改为 low/medium/high
TASK_CONTENT_REASONING_EFFORT=none
# 课程架构语义审查：auto 仅高风险触发；off 关闭；always 仅评测使用
ARCHITECT_REVIEW_MODE=auto
# 架构、Outline、章节计划的推理档位；默认 low，可全局改为 none 提速
OUTLINE_REASONING_EFFORT=low
# 架构生成默认 none，优先保证首屏章节骨架；质量回归时可改回 low
ARCHITECT_REASONING_EFFORT=none
PLAN_REASONING_EFFORT=low
# 章节计划质量审查：auto 仅风险触发；off 关闭；always 仅评测使用
PLAN_REVIEW_MODE=auto
SEARCH_API_KEY=your_search_api_key

# Next.js BFF → Python Agent 的服务间凭证；生产必填
PYTHON_INTERNAL_TOKEN=replace_with_a_long_random_value
